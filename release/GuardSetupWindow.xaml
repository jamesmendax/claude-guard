<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Guard" Language="zh-CN" Width="1020" Height="770" MinWidth="720" MinHeight="550"
        WindowStartupLocation="CenterScreen" Background="#F8F6F0" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Foreground="#302E29"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Paper" Color="#F8F6F0" />
    <SolidColorBrush x:Key="Sheet" Color="#FFFEFB" />
    <SolidColorBrush x:Key="Ink" Color="#302E29" />
    <SolidColorBrush x:Key="Muted" Color="#646056" />
    <SolidColorBrush x:Key="Line" Color="#DEDACF" />
    <SolidColorBrush x:Key="Clay" Color="#A85138" />
    <SolidColorBrush x:Key="Green" Color="#365E47" />
    <SolidColorBrush x:Key="Amber" Color="#795018" />
    <SolidColorBrush x:Key="Red" Color="#914431" />
    <SolidColorBrush x:Key="GoodPaper" Color="#E7EEE4" />
    <SolidColorBrush x:Key="AmberPaper" Color="#F8EDDB" />
    <SolidColorBrush x:Key="RedPaper" Color="#F6E7DF" />
    <SolidColorBrush x:Key="QuietPaper" Color="#F1EEE6" />
    <FontFamily x:Key="Serif">Georgia, SimSun</FontFamily>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="{StaticResource Serif}" />
      <Setter Property="FontSize" Value="23" />
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="Rule" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{StaticResource Line}" />
    </Style>
    <Style x:Key="ActionFocus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate><Border BorderBrush="{StaticResource Clay}" BorderThickness="2" CornerRadius="8" Margin="-3" /></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Sheet}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="#C9C2B4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinHeight" Value="37" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ActionFocus}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.68" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.47" /></Trigger>
              <Trigger Property="Tag" Value="Selected"><Setter TargetName="ButtonSurface" Property="Background" Value="#EAE6DD" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="{StaticResource Clay}" />
      <Setter Property="BorderBrush" Value="#984A33" />
      <Setter Property="Foreground" Value="{StaticResource Sheet}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#78513D" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource TextAction}">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Padding" Value="11,6" />
    </Style>
    <Style x:Key="CheckExpander" TargetType="Expander">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton x:Name="HeaderButton" Content="{TemplateBinding Header}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                            FocusVisualStyle="{StaticResource ActionFocus}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="Transparent">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                        <ContentPresenter />
                        <Path x:Name="Caret" Grid.Column="1" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource Muted}"
                              StrokeThickness="1.25" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F8F4EC" /></Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Caret" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Details" Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ZoneMenu" TargetType="ComboBox">
      <Setter Property="FocusVisualStyle" Value="{StaticResource ActionFocus}" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Choice" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="#E9EFE3" /></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="#F1EEE6" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" IsTabStop="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ZoneSurface" Background="#FCFAF5" BorderBrush="#C9C2B4" BorderThickness="1" CornerRadius="7">
                      <Path Data="M0 0 L4.5 4.5 L9 0" Stroke="#646056" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ZoneSurface" Property="Background" Value="#F8F6F0" /></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="ZoneSurface" Property="BorderBrush" Value="{StaticResource Clay}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,32,0" />
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                <Border Background="#FCFAF5" BorderBrush="#C9C2B4" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,3,0,0"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.56" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>
  <Grid Background="{StaticResource Paper}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="33,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Local">
          <Button x:Name="HomeNav" Style="{StaticResource Nav}" Margin="0,0,5,0" Content="总览" AutomationProperties.AcceleratorKey="Alt+1" />
          <Button x:Name="NodesNav" Style="{StaticResource Nav}" Margin="0,0,5,0" Content="节点设置" AutomationProperties.AcceleratorKey="Alt+2" />
          <Button x:Name="AuditNav" Style="{StaticResource Nav}" Content="核对清单" AutomationProperties.AcceleratorKey="Alt+3" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
          <Viewbox Width="23" Height="26" Margin="0,0,10,0">
            <Canvas Width="24" Height="24">
              <Path Data="M12 2 L21 6 V11 C21 16.6 17.6 20.1 12 22 C6.4 20.1 3 16.6 3 11 V6 Z" Stroke="{StaticResource Clay}" StrokeThickness="1.6" StrokeLineJoin="Round" />
              <Path Data="M8 11.8 L11 14.5 L16.3 9.2" Stroke="{StaticResource Clay}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="Claude Guard" FontFamily="Georgia" FontSize="27" TextWrapping="NoWrap" />
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="34,29,34,25">
      <StackPanel x:Name="PageContent" MaxWidth="948">
        <TextBlock x:Name="PageStep" Style="{StaticResource Label}" Foreground="{StaticResource Clay}" Margin="0,0,0,12" Visibility="Collapsed" />
        <TextBlock x:Name="PageTitle" FontFamily="{StaticResource Serif}" FontSize="43" AutomationProperties.HeadingLevel="Level1" Focusable="True" />
        <TextBlock x:Name="PageDescription" Style="{StaticResource Body}" FontSize="15" Margin="0,8,0,21" />

        <StackPanel x:Name="HomePage" Visibility="Collapsed" Width="{Binding ActualWidth, ElementName=PageContent}" MaxWidth="708">
          <Border Style="{StaticResource Panel}" Padding="25,19,25,17">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="当前 Guard 节点" Style="{StaticResource Label}" />
                  <TextBlock x:Name="HomeNode" Style="{StaticResource SectionTitle}" FontSize="25" Margin="0,5,0,0" />
                </StackPanel>
                <Border x:Name="HomeStateBadge" Grid.Column="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="HomeStateDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="HomeState" FontSize="12" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
              </Grid>
              <Border Style="{StaticResource Rule}" Margin="0,17,0,12" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                  <TextBlock x:Name="HomeIpLabel" Style="{StaticResource Label}" />
                  <TextBlock x:Name="HomeIp" FontFamily="Consolas, Microsoft YaHei UI" FontSize="18" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Line}" />
                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                  <TextBlock Text="Windows 时区" Style="{StaticResource Label}" />
                  <TextBlock x:Name="HomeZone" FontSize="17" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource Rule}" Margin="0,13,0,13" />
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                  <Button x:Name="HomeNodes" Style="{StaticResource Action}" Content="更换节点" Margin="0,0,8,0" />
                  <Button x:Name="HomePrimary" Style="{StaticResource Primary}" />
                </StackPanel>
                <TextBlock x:Name="HomeActionDescription" Style="{StaticResource Body}" VerticalAlignment="Center" FontSize="13" />
              </DockPanel>
            </StackPanel>
          </Border>
          <DockPanel Margin="1,10,1,12">
            <Button x:Name="HomeAudit" DockPanel.Dock="Right" Style="{StaticResource TextAction}" Content="逐项核对 ›" AutomationProperties.Name="逐项核对" />
            <TextBlock x:Name="HomeEntry" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
          </DockPanel>
          <Border Style="{StaticResource Panel}" Padding="20,13">
            <DockPanel>
              <Button x:Name="HomeStopDetails" DockPanel.Dock="Right" Style="{StaticResource Action}" Content="查看停止详情" VerticalAlignment="Center" Margin="12,0,0,0" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="最近一次停止" FontWeight="SemiBold" />
                <TextBlock x:Name="HomeStopSummary" Style="{StaticResource Body}" Margin="0,3,0,0" />
                <TextBlock x:Name="HomeWindowError" Style="{StaticResource Body}" Margin="0,3,0,0" Visibility="Collapsed" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>

        <Grid x:Name="NodesPage" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.48*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel}" Padding="21,18" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="节点与时区" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="VLESS 节点链接" FontWeight="SemiBold" Margin="0,16,0,0" />
              <Border BorderBrush="#C9C2B4" BorderThickness="1" CornerRadius="7" Margin="0,7,0,0" Background="#FCFAF5">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <PasswordBox x:Name="MaskedNode" MaxLength="4096" AutomationProperties.Name="VLESS 节点链接" BorderThickness="0" Background="Transparent" MinHeight="39" VerticalContentAlignment="Center" Padding="10,3" />
                  <TextBox x:Name="VisibleNode" MaxLength="4096" Visibility="Collapsed" AutomationProperties.Name="VLESS 节点链接（已显示）" BorderThickness="0" Background="Transparent" MinHeight="39" VerticalContentAlignment="Center" Padding="10,3" UndoLimit="0" />
                  <CheckBox x:Name="RevealNode" Grid.Column="1" Content="显示链接" VerticalAlignment="Center" Margin="9,0,11,0" Foreground="{StaticResource Muted}" />
                </Grid>
              </Border>
              <TextBlock Text="支持 VLESS Reality/TCP 或 WebSocket/TLS。" Style="{StaticResource Label}" Margin="0,7,0,0" />
              <Border Style="{StaticResource Rule}" Margin="0,18,0,14" />
              <TextBlock Text="应用后的 Windows 时区" FontWeight="SemiBold" />
              <ComboBox x:Name="Zones" Style="{StaticResource ZoneMenu}" DisplayMemberPath="Label" SelectedValuePath="Id" AutomationProperties.Name="应用后的 Windows 时区"
                        MinHeight="39" VerticalContentAlignment="Center" MaxDropDownHeight="320" Margin="0,7,0,1" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="20,18" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="试测回执" Style="{StaticResource SectionTitle}" />
              <Border x:Name="ProofCard" CornerRadius="6" Padding="9,6" Margin="0,11,0,0" HorizontalAlignment="Left">
                <TextBlock x:Name="ProofTitle" FontSize="13" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
              </Border>
              <StackPanel x:Name="ProofFacts" Visibility="Collapsed" Margin="0,9,0,0">
                <Border Style="{StaticResource Rule}" Margin="0,0,0,7" />
                <DockPanel><TextBlock x:Name="ProofIp" DockPanel.Dock="Right" FontFamily="Consolas" /><TextBlock Text="公网 IPv4" Style="{StaticResource Label}" /></DockPanel>
                <Border Style="{StaticResource Rule}" Margin="0,8,0,7" />
                <DockPanel><TextBlock x:Name="ProofCountry" DockPanel.Dock="Right" /><TextBlock Text="出口国家" Style="{StaticResource Label}" /></DockPanel>
                <Border Style="{StaticResource Rule}" Margin="0,8,0,7" />
                <TextBlock Text="应用后的时区" Style="{StaticResource Label}" />
                <TextBlock x:Name="ProofZone" Margin="0,2,0,0" />
              </StackPanel>
              <TextBlock x:Name="ProofDetail" Style="{StaticResource Body}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
              <TextBlock x:Name="ProofExpiry" Style="{StaticResource Label}" Margin="0,7,0,0" Visibility="Collapsed" />
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel x:Name="ChecksPage" Visibility="Collapsed">
          <Border x:Name="ChecksLead" Style="{StaticResource Panel}" Padding="16,12" Margin="0,0,0,13" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="ChecksLeadTitle" FontWeight="SemiBold" />
              <TextBlock x:Name="ChecksLeadDetail" Style="{StaticResource Body}" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Panel}" Padding="18,15">
            <StackPanel>
              <DockPanel Margin="0,0,0,11">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="AllChecks" Style="{StaticResource Nav}" Content="全部" />
                  <Button x:Name="IssueChecks" Style="{StaticResource Nav}" Content="只看问题" />
                  <Button x:Name="ChangeChecks" Style="{StaticResource Nav}" Content="只看改动" />
                </StackPanel>
                <TextBlock Text="核对清单" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
              </DockPanel>
              <StackPanel x:Name="CheckRows" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="WorkPage" Visibility="Collapsed">
          <Border Style="{StaticResource Panel}" Padding="23,21">
            <StackPanel>
              <TextBlock x:Name="WorkPhase" Style="{StaticResource SectionTitle}" AutomationProperties.LiveSetting="Polite" />
              <TextBlock x:Name="WorkDetail" Style="{StaticResource Body}" Margin="0,7,0,0" />
              <UniformGrid x:Name="WorkStages" Rows="1" Margin="0,15,0,0" Visibility="Collapsed" />
              <Border Style="{StaticResource Rule}" Margin="0,14,0,13" />
              <Border Background="{StaticResource QuietPaper}" CornerRadius="8" Padding="13,11">
                <StackPanel>
                  <TextBlock x:Name="WorkProofSummary" FontWeight="SemiBold" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                  <UniformGrid x:Name="WorkProofs" Rows="1" Margin="0,7,0,0" Visibility="Collapsed" />
                  <ProgressBar x:Name="WorkProgress" Height="7" IsIndeterminate="True" Foreground="{StaticResource Clay}" Background="#E4DFD4"
                               BorderThickness="0" AutomationProperties.Name="当前操作进度" />
                </StackPanel>
              </Border>
              <TextBlock x:Name="WorkNote" Style="{StaticResource Body}" Margin="0,13,0,0" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="ResultPage" Visibility="Collapsed">
          <Border Style="{StaticResource Panel}" Padding="22,20">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="ResultMarkSurface" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <TextBlock x:Name="ResultMark" FontFamily="Segoe UI Symbol" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0,0,0" AutomationProperties.LiveSetting="Polite">
                  <TextBlock x:Name="ResultTitle" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="ResultMessage" Style="{StaticResource Body}" Margin="0,7,0,0" />
                </StackPanel>
              </Grid>
              <StackPanel x:Name="ResultFacts" Margin="0,13,0,0" Visibility="Collapsed" />
              <TextBlock x:Name="ResultEntry" Margin="0,13,0,0" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="StopPage" Visibility="Collapsed">
          <Border Style="{StaticResource Panel}" Padding="23,18">
            <StackPanel>
              <TextBlock Text="受防护的 Claude 会话" Style="{StaticResource Label}" Margin="0,0,0,8" />
              <Border Background="{StaticResource QuietPaper}" CornerRadius="7" Padding="12,10">
                <StackPanel>
                  <TextBlock x:Name="StopTitle" Style="{StaticResource SectionTitle}" />
                  <TextBlock x:Name="StopSummary" Style="{StaticResource Body}" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <StackPanel x:Name="StopFacts" Margin="0,11,0,0" />
              <Expander x:Name="StopExtra" Style="{StaticResource CheckExpander}" Header="更多记录" AutomationProperties.Name="更多停止记录" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="StopExtraText" Style="{StaticResource Body}" Margin="0,8,0,0" />
              </Expander>
            </StackPanel>
          </Border>
          <Border x:Name="WindowErrorCard" Style="{StaticResource Panel}" Padding="23,18" Margin="0,13,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="设置窗口" Style="{StaticResource Label}" Margin="0,0,0,6" />
              <TextBlock x:Name="WindowErrorTitle" Style="{StaticResource SectionTitle}" />
              <TextBlock x:Name="WindowErrorSummary" Style="{StaticResource Body}" Margin="0,5,0,0" />
              <StackPanel x:Name="WindowErrorFacts" Margin="0,11,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="33,9">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="BackButton" Style="{StaticResource TextAction}" Margin="0,0,8,0" Visibility="Collapsed" />
          <Button x:Name="LeaveButton" Style="{StaticResource TextAction}" Content="关闭" Margin="0,0,8,0" />
          <Button x:Name="ProbeButton" Style="{StaticResource Action}" Content="试测出口" Margin="0,0,8,0" Visibility="Collapsed" />
          <Button x:Name="CancelProbeButton" Style="{StaticResource Action}" Content="取消试测" Visibility="Collapsed" />
          <Button x:Name="PrimaryButton" Style="{StaticResource Primary}" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="FooterText" Style="{StaticResource Label}" />
          <TextBlock x:Name="Version" Style="{StaticResource Label}" Text="Claude Guard 1.0.1" FontSize="12" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
