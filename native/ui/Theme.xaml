<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================== DESIGN TOKENS (DIETER RAMS x SWISS GRID) ==================== -->
  <SolidColorBrush x:Key="RailBrush" Color="#EFEFF2"/>
  <SolidColorBrush x:Key="CanvasBrush" Color="#F7F7F8"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F8F9FB"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#E2E4E9"/>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFD3DC"/>
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#C8CDD6"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#EFF1F4"/>

  <SolidColorBrush x:Key="InkBrush" Color="#121418"/>
  <SolidColorBrush x:Key="Ink2Brush" Color="#4B5162"/>
  <SolidColorBrush x:Key="Ink3Brush" Color="#7A8194"/>

  <SolidColorBrush x:Key="PrimaryBrush" Color="#15181E"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#262B36"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#0C0E12"/>

  <SolidColorBrush x:Key="OkBrush" Color="#15803D"/>
  <SolidColorBrush x:Key="OkDotBrush" Color="#16A34A"/>
  <SolidColorBrush x:Key="OkSoftBrush" Color="#ECFDF3"/>
  <SolidColorBrush x:Key="OkBorderBrush" Color="#BBF7D0"/>
  <SolidColorBrush x:Key="OkHaloBrush" Color="#DCFCE7"/>
  <SolidColorBrush x:Key="OkHaloBorderBrush" Color="#86EFAC"/>

  <SolidColorBrush x:Key="WarnBrush" Color="#B45309"/>
  <SolidColorBrush x:Key="WarnDotBrush" Color="#D97706"/>
  <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFFBEB"/>
  <SolidColorBrush x:Key="WarnBorderBrush" Color="#FDE68A"/>
  <SolidColorBrush x:Key="WarnHaloBrush" Color="#FEF3C7"/>
  <SolidColorBrush x:Key="WarnHaloBorderBrush" Color="#FCD34D"/>

  <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>
  <SolidColorBrush x:Key="DangerDotBrush" Color="#DC2626"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2"/>
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECACA"/>
  <SolidColorBrush x:Key="DangerOutlineBrush" Color="#F3C4C4"/>
  <SolidColorBrush x:Key="DangerHaloBrush" Color="#FEE2E2"/>
  <SolidColorBrush x:Key="DangerHaloBorderBrush" Color="#FCA5A5"/>
  <SolidColorBrush x:Key="DangerTextDarkBrush" Color="#7F1D1D"/>

  <SolidColorBrush x:Key="IdleDotBrush" Color="#9CA3AF"/>
  <SolidColorBrush x:Key="IdleHaloBrush" Color="#F1F5F9"/>
  <SolidColorBrush x:Key="IdleHaloBorderBrush" Color="#CBD5E1"/>

  <SolidColorBrush x:Key="DisabledBgBrush" Color="#F1F2F5"/>
  <SolidColorBrush x:Key="DisabledBorderBrush" Color="#E2E4EA"/>
  <SolidColorBrush x:Key="DisabledFgBrush" Color="#9BA1B0"/>

  <!-- ==================== CARD CONTAINER ==================== -->
  <Style x:Key="CardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <Style x:Key="SubtleCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SubtleSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>

  <!-- ==================== BUTTONS ==================== -->
  <Style x:Key="PrimaryButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="33"/>
    <Setter Property="Padding" Value="18,0"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource DisabledBgBrush}"/>
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource DisabledFgBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="33"/>
    <Setter Property="Padding" Value="13,0"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#F3F4F6"/>
              <Setter TargetName="Bg" Property="BorderBrush" Value="#BAC0CC"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#E9ECF0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource DisabledBgBrush}"/>
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource DisabledFgBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="33"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#E8EAEE"/>
              <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#DFE2E8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledFgBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerOutlineButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="33"/>
    <Setter Property="Padding" Value="13,0"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource DangerOutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
              <Setter TargetName="Bg" Property="BorderBrush" Value="#FCA5A5"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#FEE2E2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource DisabledBgBrush}"/>
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource DisabledBorderBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource DisabledFgBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SmallSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="11,0"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style x:Key="SmallDangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerOutlineButtonStyle}">
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="11,0"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- ==================== CHROME TITLEBAR BUTTONS ==================== -->
  <Style x:Key="TitleBarMinButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#4A505E"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#E2E4E9"/>
              <Setter Property="Foreground" Value="#121418"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarMinButtonStyle}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#DC2626"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== LEFT RAIL NAVIGATION TAB ==================== -->
  <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Pill"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="10,8">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="#E6E8ED"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="#FFFFFF"/>
              <Setter TargetName="Pill" Property="BorderBrush" Value="#E2E5EC"/>
              <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== SEGMENTED LANGUAGE SWITCH ==================== -->
  <Style x:Key="SegLangRadioStyle" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#6B7280"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="7,2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#FFFFFF"/>
              <Setter Property="Foreground" Value="#121418"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== HARDWARE PILL TOGGLE SWITCH ==================== -->
  <Style x:Key="HardwareToggleStyle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="Track" Width="30" Height="17" CornerRadius="8.5" Background="#D0D5DD" VerticalAlignment="Center">
              <Canvas Width="30" Height="17">
                <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="#FFFFFF" Canvas.Left="2" Canvas.Top="2"/>
              </Canvas>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="#15181E"/>
              <Setter TargetName="Thumb" Property="Canvas.Left" Value="15"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== CLEAN TEXTBOX ==================== -->
  <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
    <Setter Property="Height" Value="32"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CaretBrush" Value="#121418"/>
    <Setter Property="SelectionBrush" Value="#D0D5DD"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="0"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="#15181E"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Border" Property="Background" Value="#F3F4F6"/>
              <Setter Property="Foreground" Value="#9BA1B0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== CLEAN COMBOBOX ==================== -->
  <Style x:Key="CleanComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Height" Value="28"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,0,24,0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="ToggleBtn"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press"
                          Cursor="Hand">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd"
                          Background="#FFFFFF"
                          BorderBrush="#CFD3DC"
                          BorderThickness="1"
                          CornerRadius="6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                      </Grid.ColumnDefinitions>
                      <Path Grid.Column="1"
                            Data="M 0,0 L 4,4 L 8,0"
                            Stroke="#6B7280"
                            StrokeThickness="1.4"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="Bd" Property="Background" Value="#F1F2F5"/>
                      <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E4EA"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ContentSite"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="9,0,24,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"/>
            <Popup x:Name="Popup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">
              <Border Margin="0,3,0,0"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="#FFFFFF"
                      BorderBrush="#CFD3DC"
                      BorderThickness="1"
                      CornerRadius="7"
                      Padding="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel IsItemsHost="True"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
